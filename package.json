{
  "name": "branchmaid",
  "version": "0.2.0",
  "description": "Tidy up stale git branches safely",
  "license": "MIT",
  "author": "Aditya Verma",
  "type": "module",
  "devDependencies": {
    "@types/node": "^26.6.6",
    "prettier": "^3.10.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.check.json",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "format": "prettier --write .",
    "lint": "prettier --check ."
  },
  "bin": {
    "branchmaid": "dist/cli.js"
  },
  "engines": {
    "node": ">=20.12"
  },
  "dependencies": {
    "@clack/prompts": "^1.9.0",
    "picocolors": "^1.1.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adityaverma/branchmaid.git"
  },
  "homepage": "https://github.com/adityaverma/branchmaid#readme",
  "bugs": {
    "url": "https://github.com/adityaverma/branchmaid/issues"
  },
  "files": [
    "dist",
    "schema.json"
  ],
  "keywords": [
    "git",
    "branches",
    "cleanup",
    "cli",
    "prune"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  }
}
